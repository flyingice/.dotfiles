{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Agent",
      "WebFetch",
      "WebSearch",
      "Skill"
    ],
    "deny": [
      "Bash(dd *)",
      "Bash(shred *)",
      "Bash(truncate *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git clean -f*)",
      "Bash(git push*)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "theme": "light-ansi",
  "editorMode": "vim"
}
